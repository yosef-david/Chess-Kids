{
  "name": "chess-kids",
  "version": "0.1.0",
  "private": true,
  "description": "Chess Kids — Hebrew chess website prototype",
  "scripts": {
    "dev": "node scripts/copy-engine.mjs && vite --host 0.0.0.0",
    "build": "node scripts/copy-engine.mjs && vite build && node scripts/smoke-check.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "vite": "^6.0.7",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "stockfish": "19.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.chesskids.desktop",
    "productName": "Chess Kids",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
